<Window x:Class="AgosClip.ItemPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="预览" Width="900" Height="700" MinWidth="360" MinHeight="260" ShowInTaskbar="True" Topmost="True"
        WindowStartupLocation="Manual" Icon="pack://application:,,,/Assets/AgosClip.ico"
        Background="{DynamicResource PanelBg}" Foreground="{DynamicResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <!-- immersive: our header is the title bar (drag it; double-click maximises); resizable from the edges -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Border Background="{DynamicResource PanelBg}" Padding="12,8,12,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid Margin="2,0,-2,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="PreviewTitle" Text="预览" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="PreviewInfo" FontSize="11" Foreground="{DynamicResource SubFg}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Button x:Name="PreviewZoomOut" WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE71F;" FontSize="12"
                                        ToolTip="缩小 (-)" Click="PreviewZoomOut_Click"/>
                                <Button x:Name="PreviewZoomText" WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="2" Style="{StaticResource IconButton}" Width="48" FontSize="11.5"
                                        FontFamily="{StaticResource UiFont}" Content="适应" ToolTip="在适应窗口和 100% 之间切换 (0)" Click="PreviewZoomToggle_Click"/>
                                <Button x:Name="PreviewZoomIn" WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE8A3;" FontSize="12"
                                        ToolTip="放大 (+)，也可以 Ctrl + 滚轮" Click="PreviewZoomIn_Click"/>
                                <Button x:Name="MaxBtn" Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE922;" FontSize="11"
                                        ToolTip="最大化 / 还原" Click="Max_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                                <Button Grid.Column="5" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12"
                                        ToolTip="关闭 (Esc / 空格)" Click="PreviewClose_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                            </Grid>
                            <Border Grid.Row="1" CornerRadius="8" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <ScrollViewer x:Name="PreviewImageScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                                  Visibility="Collapsed" PreviewMouseWheel="PreviewImage_Wheel" SizeChanged="PreviewScroller_SizeChanged">
                                        <Image x:Name="PreviewImage" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" MouseLeftButtonDown="PreviewImage_Click">
                                            <Image.LayoutTransform>
                                                <ScaleTransform x:Name="PreviewScale"/>
                                            </Image.LayoutTransform>
                                        </Image>
                                    </ScrollViewer>
                                    <TextBox x:Name="PreviewText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,6"
                                             FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12.5"
                                             Foreground="{DynamicResource Fg}" SelectionBrush="{DynamicResource Accent}"
                                             Visibility="Collapsed" IsUndoEnabled="False"/>
                                    <TextBlock x:Name="PreviewMessage" Margin="20" TextAlignment="Center" TextWrapping="Wrap"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SubFg}" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Grid>
    </Border>
</Window>
