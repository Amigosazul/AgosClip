<Window x:Class="AgosClip.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgosClip" Width="400" Height="580"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Left="-32000" Top="-32000"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" NonClientFrameEdges="None" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Date segment (segmented-control style: selected = raised pill) -->
        <Style x:Key="DayCardItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DayCard_MouseDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="11,5,11,6" MinWidth="60">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="pin" Text="&#xE718;" FontFamily="{StaticResource IconFont}" FontSize="10.5"
                                               Margin="0,1,4,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <TextBlock x:Name="t" Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                                <TextBlock x:Name="s" Text="{Binding Sub}" FontSize="10.5" Foreground="{DynamicResource SubFg}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter TargetName="pin" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource CardBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SegSelected}"/>
                                <Setter TargetName="b" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.14" Color="Black"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="s" Property="Foreground" Value="{DynamicResource SegAccent}"/>
                                <Setter TargetName="pin" Property="Foreground" Value="{DynamicResource SegAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- History entry -->
        <Style x:Key="ClipItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="MouseLeftButtonUp" Handler="Item_Click"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1" CornerRadius="10" Padding="12,10,8,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ContentPresenter Margin="0,0,4,0"/>
                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource SubFg}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="pinBtn" Grid.Column="1" Style="{StaticResource IconButton}" Width="26" Height="24" FontSize="12"
                                            Content="{Binding PinGlyph}" ToolTip="固定 / 取消固定 (Ctrl+P)" Click="Pin_Click" Visibility="Hidden"/>
                                    <Button x:Name="delBtn" Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="24" FontSize="12"
                                            Content="&#xE74D;" ToolTip="删除 (Del)" Click="Delete_Click" Visibility="Hidden"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                <Setter TargetName="pinBtn" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="pinBtn" Property="Foreground" Value="{DynamicResource Accent}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource CardHover}"/>
                                <Setter TargetName="pinBtn" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="delBtn" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SelBg}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="pinBtn" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="delBtn" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ItemTemplate">
            <Grid>
                <TextBlock x:Name="txt" Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           LineHeight="19" LineStackingStrategy="BlockLineHeight" MaxHeight="76"/>
                <Rectangle x:Name="img" Visibility="Collapsed" HorizontalAlignment="Left"
                           Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" RadiusX="7" RadiusY="7"
                           Stroke="{DynamicResource CardBorder}" StrokeThickness="1"
                           RenderOptions.BitmapScalingMode="HighQuality">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsImage}" Value="True">
                    <Setter TargetName="txt" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="img" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="CalDay" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Track}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Keep the content at its full height while the native window reveals it from its anchor edge. -->
    <Grid ClipToBounds="True">
    <Border x:Name="Root" Height="580" VerticalAlignment="Top"
            Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Hairline}"
            BorderThickness="1" CornerRadius="8" MouseLeftButtonDown="Root_MouseDown">
        <Grid>
            <Border Height="140" VerticalAlignment="Top" CornerRadius="8,8,0,0" Background="{DynamicResource Sheen}" IsHitTestVisible="False"/>
            <!-- grip: hints that the panel can be dragged by its top -->
            <Border Width="34" Height="4" CornerRadius="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,5,0,0"
                    Background="{DynamicResource SubFg}" Opacity="0.3" IsHitTestVisible="False"/>

            <Grid Margin="14,10,14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid x:Name="Header" Grid.Row="0" Margin="2,0,-4,8" Background="Transparent"
                      ToolTip="拖动可移动面板" ToolTipService.InitialShowDelay="1200">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="剪贴板" FontSize="15" FontWeight="SemiBold"/>
                        <Border x:Name="PausedBadge" Background="{DynamicResource SelBg}" CornerRadius="6" Padding="6,1"
                                Margin="8,1,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="已暂停记录" FontSize="10.5" Foreground="{DynamicResource Accent}"/>
                        </Border>
                    </StackPanel>
                    <Button x:Name="StickyBtn" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE718;"
                            ToolTip="固定在桌面：点别处或粘贴后不自动关闭" Click="Sticky_Click"/>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="设置" Click="Settings_Click"/>
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" ToolTip="关闭 (Esc)" Click="Close_Click"/>
                </Grid>

                <!-- Search -->
                <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource SearchBox}" Tag="搜索全部历史"
                         TextChanged="Search_TextChanged"/>

                <!-- Date segments -->
                <Border Grid.Row="2" Margin="0,10,0,0" Background="{DynamicResource Track}" CornerRadius="11" Padding="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="DayList" ItemContainerStyle="{StaticResource DayCardItem}" Background="Transparent"
                                 BorderThickness="0" Padding="0" Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 SelectionChanged="DayList_SelectionChanged" PreviewMouseWheel="DayList_PreviewMouseWheel">
                            <ListBox.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Black" Offset="0"/>
                                    <GradientStop Color="Black" Offset="0.9"/>
                                    <GradientStop Color="#30000000" Offset="1"/>
                                </LinearGradientBrush>
                            </ListBox.OpacityMask>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <Border Grid.Column="1" Width="1" Margin="2,8,2,8" Background="{DynamicResource CardBorder}" HorizontalAlignment="Left"/>
                        <Button x:Name="CalButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE787;" FontSize="15"
                                Width="36" Height="40" Margin="5,0,0,0" ToolTip="按日历选择日期" Click="Cal_Click"/>
                    </Grid>
                </Border>

                <!-- Section title -->
                <TextBlock x:Name="SectionTitle" Grid.Row="3" Margin="4,12,2,7" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource SubFg}"/>

                <!-- Items -->
                <Grid Grid.Row="4">
                    <ListBox x:Name="ItemList" ItemContainerStyle="{StaticResource ClipItem}" ItemTemplate="{StaticResource ItemTemplate}"
                             Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"/>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="20">
                        <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="30" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SubFg}" Opacity="0.6" Margin="0,0,0,10"/>
                        <TextBlock x:Name="EmptyText" TextAlignment="Center" Foreground="{DynamicResource SubFg}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- Footer: keycap hints -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="2,8,0,0">
                    <Border Style="{StaticResource Key}"><TextBlock Text="↑↓"/></Border>
                    <TextBlock Style="{StaticResource KeyLabel}" Text="选择"/>
                    <Border Style="{StaticResource Key}"><TextBlock Text="↵"/></Border>
                    <TextBlock Style="{StaticResource KeyLabel}" Text="粘贴"/>
                    <Border Style="{StaticResource Key}"><TextBlock Text="←→"/></Border>
                    <TextBlock Style="{StaticResource KeyLabel}" Text="日期"/>
                    <Border Style="{StaticResource Key}"><TextBlock Text="Del"/></Border>
                    <TextBlock Style="{StaticResource KeyLabel}" Text="删除"/>
                    <Border Style="{StaticResource Key}"><TextBlock Text="Ctrl P"/></Border>
                    <TextBlock Style="{StaticResource KeyLabel}" Text="固定" Margin="0"/>
                </StackPanel>

                <!-- Calendar overlay (inside the window so it shares the glass) -->
                <Grid x:Name="CalOverlay" Grid.RowSpan="6" Margin="-14,-10" Visibility="Collapsed">
                    <Rectangle Fill="{DynamicResource Dim}" RadiusX="8" RadiusY="8" MouseLeftButtonDown="CalBackdrop_Click"/>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,118,14,0" Width="262"
                            Height="{Binding ActualHeight, ElementName=CalCard}" CornerRadius="12" Background="{DynamicResource OverlayBg}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.25" Color="Black"/>
                        </Border.Effect>
                    </Border>
                    <Border x:Name="CalCard" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,118,14,0"
                            Background="{DynamicResource OverlayBg}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                            CornerRadius="12" Padding="10" Width="262">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="CalPrev" Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="11" Click="CalPrev_Click"/>
                                <TextBlock x:Name="CalTitle" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>
                                <Button x:Name="CalNext" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="11" Click="CalNext_Click"/>
                            </Grid>
                            <UniformGrid Columns="7" Margin="0,0,0,2" TextElement.FontSize="11" TextElement.Foreground="{DynamicResource SubFg}">
                                <TextBlock Text="一" HorizontalAlignment="Center"/>
                                <TextBlock Text="二" HorizontalAlignment="Center"/>
                                <TextBlock Text="三" HorizontalAlignment="Center"/>
                                <TextBlock Text="四" HorizontalAlignment="Center"/>
                                <TextBlock Text="五" HorizontalAlignment="Center"/>
                                <TextBlock Text="六" HorizontalAlignment="Center"/>
                                <TextBlock Text="日" HorizontalAlignment="Center"/>
                            </UniformGrid>
                            <UniformGrid x:Name="CalGrid" Columns="7"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>
