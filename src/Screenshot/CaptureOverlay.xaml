<Window x:Class="AgosClip.CaptureOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgosClip 截图" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Black" Cursor="Cross" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        WindowStartupLocation="Manual" Left="-32000" Top="-32000" Width="10" Height="10">
    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Track}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Canvas x:Name="Stage" ClipToBounds="True">
        <Image x:Name="Shot" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <!-- dim everything except the selection (even-odd: full rect minus selection) -->
        <Path x:Name="Dim" Fill="#8C000000" IsHitTestVisible="False">
            <Path.Data>
                <GeometryGroup FillRule="EvenOdd">
                    <RectangleGeometry x:Name="DimAll"/>
                    <RectangleGeometry x:Name="DimHole"/>
                </GeometryGroup>
            </Path.Data>
        </Path>
        <Rectangle x:Name="SelBorder" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Border x:Name="SizeLabel" Background="#CC1E1E20" CornerRadius="4" Padding="6,2" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="11.5"/>
        </Border>
        <Border x:Name="Hint" Background="#CC1E1E20" CornerRadius="8" Padding="14,8" IsHitTestVisible="False">
            <TextBlock Foreground="White" Text="拖动鼠标选择截图区域 · Enter 复制 · Esc 取消"/>
        </Border>

        <!-- toolbar at the selection's bottom-right -->
        <Border x:Name="Toolbar" Visibility="Collapsed" Cursor="Arrow" Background="{DynamicResource OverlayBg}"
                BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="9" Padding="4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.3" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CopyBtn" Style="{StaticResource ToolBtn}" Click="Copy_Click" ToolTip="复制到剪贴板 (Enter / 双击)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,6,0"/>
                            <TextBlock Text="复制"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PinBtn" Style="{StaticResource ToolBtn}" Click="Pin_Click" ToolTip="钉在屏幕上">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,6,0"/>
                            <TextBlock Text="钉图"/>
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="6,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolBtn}" Click="Cancel_Click" ToolTip="取消 (Esc / 右键)" Padding="9,5">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,0,0"/>
                    </Button>
                </StackPanel>
                <!-- pin choices: on top of everything, or a normal window -->
                <StackPanel x:Name="PinMenu" Visibility="Collapsed" Margin="0,4,0,0">
                    <Border Height="1" Background="{DynamicResource CardBorder}" Margin="4,0,4,4"/>
                    <Button x:Name="PinTopBtn" Style="{StaticResource ToolBtn}" Click="PinTop_Click">
                        <StackPanel>
                            <TextBlock Text="置顶钉图" FontWeight="SemiBold"/>
                            <TextBlock Text="始终显示在所有窗口最上面" FontSize="11" Foreground="{DynamicResource SubFg}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PinNormalBtn" Style="{StaticResource ToolBtn}" Click="PinNormal_Click">
                        <StackPanel>
                            <TextBlock Text="普通钉图" FontWeight="SemiBold"/>
                            <TextBlock Text="不置顶，可以被其他窗口挡住" FontSize="11" Foreground="{DynamicResource SubFg}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
