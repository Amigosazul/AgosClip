<Window x:Class="AgosClip.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgosClip 钉图" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Black" UseLayoutRounding="True" FontFamily="{StaticResource UiFont}" FontSize="12.5"
        WindowStartupLocation="Manual" Left="-32000" Top="-32000" Width="10" Height="10"
        Icon="pack://application:,,,/Assets/AgosClip.ico">
    <Window.Resources>
        <Style x:Key="PinBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#B31E1E20" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E6007AFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root">
        <Image x:Name="Picture" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Border x:Name="Frame" BorderBrush="{DynamicResource Accent}" BorderThickness="1" IsHitTestVisible="False"/>
        <!-- hover toolbar -->
        <StackPanel x:Name="Tools" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
                    Visibility="Collapsed">
            <Button x:Name="TopBtn" Style="{StaticResource PinBtn}" Click="Top_Click"/>
            <Button Style="{StaticResource PinBtn}" Content="&#xE8C8;" ToolTip="复制" Click="Copy_Click"/>
            <Button Style="{StaticResource PinBtn}" Content="&#xE74E;" ToolTip="另存为图片…" Click="Save_Click"/>
            <Button Style="{StaticResource PinBtn}" Content="&#xE711;" ToolTip="关闭 (双击 / Esc)" Click="Close_Click"/>
        </StackPanel>
        <Border x:Name="ZoomBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Background="#B31E1E20"
                CornerRadius="5" Padding="6,2" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ZoomText" Foreground="White" FontSize="11.5"/>
        </Border>
    </Grid>
</Window>
