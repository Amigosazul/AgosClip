<Window x:Class="AgosClip.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgosClip 钉图" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Black" UseLayoutRounding="True" FontFamily="{StaticResource UiFont}" FontSize="12.5"
        WindowStartupLocation="Manual" Left="-32000" Top="-32000" Width="10" Height="10"
        Icon="pack://application:,,,/Assets/AgosClip.ico">
    <Window.Resources>
        <Style x:Key="PinBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#B31E1E20" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E6007AFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root">
        <Image x:Name="Picture" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Border x:Name="Frame" BorderBrush="{DynamicResource Accent}" BorderThickness="1" IsHitTestVisible="False"/>
        <!-- hover toolbar -->
        <StackPanel x:Name="Tools" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
                    Visibility="Collapsed">
            <Button x:Name="TopBtn" Style="{StaticResource PinBtn}" Click="Top_Click"/>
            <Button Style="{StaticResource PinBtn}" Content="&#xE8C8;" ToolTip="复制" Click="Copy_Click"/>
            <Button Style="{StaticResource PinBtn}" Content="&#xE74E;" ToolTip="另存为图片…" Click="Save_Click"/>
            <Button Style="{StaticResource PinBtn}" Content="&#xE711;" ToolTip="关闭 (双击 / Esc)" Click="Close_Click"/>
        </StackPanel>
        <Border x:Name="ZoomBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Background="#B31E1E20"
                CornerRadius="5" Padding="6,2" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ZoomText" Foreground="White" FontSize="11.5" TextWrapping="Wrap"/>
        </Border>
        <!-- translation status: a pill just outside the picture (above it, or below when there is no room) so it never
             covers the text being translated; the ring spins while the translation is running -->
        <Popup x:Name="StatusPop" PlacementTarget="{Binding ElementName=Root}" Placement="Top" VerticalOffset="-6"
               AllowsTransparency="True" StaysOpen="True" Focusable="False" IsHitTestVisible="False">
            <Border Background="#E61E1E20" CornerRadius="11" Padding="8,3,10,3" Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Grid x:Name="Spinner" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse Stroke="#40FFFFFF" StrokeThickness="2"/>
                        <Path Data="M 7,1 A 6,6 0 0 1 13,7" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpinnerTurn"/>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                    <TextBlock x:Name="StatusText" Foreground="White" FontSize="12" VerticalAlignment="Center" MaxWidth="420" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
