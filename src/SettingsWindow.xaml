<Window x:Class="AgosClip.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgosClip 设置" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/AgosClip.ico"
        Background="{DynamicResource PanelBg}" Foreground="{DynamicResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubFg}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Toggle switch: label + hint on the left, switch on the right -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ContentPresenter/>
                                <TextBlock Text="{TemplateBinding Tag}" Foreground="{DynamicResource SubFg}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,2,0,0" x:Name="hint"/>
                            </StackPanel>
                            <Border x:Name="track" Grid.Column="1" Width="40" Height="20" CornerRadius="10" VerticalAlignment="Center"
                                    Background="Transparent" BorderBrush="{DynamicResource SubFg}" BorderThickness="1">
                                <Ellipse x:Name="knob" Width="12" Height="12" Fill="{DynamicResource SubFg}"
                                         HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="hint" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="knob" Property="Fill" Value="{DynamicResource AccentFg}"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Retention chip -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="GroupName" Value="retention"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="14" Padding="12,4" BorderThickness="1"
                                BorderBrush="{DynamicResource CardBorder}" Background="{DynamicResource Track}">
                            <ContentPresenter x:Name="c" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Padding="14,6" BorderThickness="1"
                                BorderBrush="{DynamicResource CardBorder}" Background="{DynamicResource CardBg}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SelBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource PanelBg}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="保留天数" Style="{StaticResource Heading}"/>
                    <WrapPanel x:Name="Retention"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="超过天数的记录会自动删除，固定的条目不会删除。相同的内容只保留一条，再次复制时会移到最新。"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="记录与粘贴" Style="{StaticResource Heading}"/>
                    <CheckBox x:Name="TakeOverWinV" Style="{StaticResource Switch}" Click="Changed"
                              Content="用 Win+V 打开 AgosClip"
                              Tag="代替系统自带的剪贴板。关闭、退出或卸载 AgosClip 后，Win+V 会恢复成系统的。"/>
                    <CheckBox x:Name="PasteAfterSelect" Style="{StaticResource Switch}" Click="Changed"
                              Content="选中后自动粘贴" Tag="关闭后只复制到剪贴板，需要自己按 Ctrl+V。"/>
                    <CheckBox x:Name="RecordImages" Style="{StaticResource Switch}" Click="Changed" Content="记录图片"/>
                    <CheckBox x:Name="StartWithWindows" Style="{StaticResource Switch}" Click="Changed" Content="开机自动启动"
                              Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource Heading}"/>
                    <CheckBox x:Name="GlassBox" Style="{StaticResource Switch}" Click="Changed" Margin="0,4,0,0"
                              Content="毛玻璃效果" Tag="面板背景透出并模糊后面的内容。需要 Windows 11 22H2 以上，并在系统设置里打开“透明效果”。"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="更新" Style="{StaticResource Heading}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="UpdateNotes" Style="{StaticResource Hint}" Margin="0,0,0,10" Visibility="Collapsed"
                               MaxHeight="90" TextTrimming="CharacterEllipsis"/>
                    <Border x:Name="ProgressTrack" Height="6" CornerRadius="3" Background="{DynamicResource Track}"
                            Margin="0,0,0,10" Visibility="Collapsed">
                        <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="{DynamicResource Accent}"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="CheckBtn" Style="{StaticResource Btn}" Content="检查更新" Click="Check_Click"/>
                        <Button x:Name="InstallBtn" Style="{StaticResource Btn}" Click="Install_Click" Visibility="Collapsed"/>
                        <Button x:Name="BrowserBtn" Style="{StaticResource Btn}" Content="用浏览器下载" Click="Browser_Click" Visibility="Collapsed"
                                ToolTip="用浏览器从最快的线路下载安装包，下载后双击安装"/>
                        <Button x:Name="PageBtn" Style="{StaticResource Btn}" Content="发布页" Click="Page_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="AutoUpdate" Style="{StaticResource Switch}" Click="Changed" Margin="0,4,0,0"
                              Content="自动检查更新" Tag="每天检查一次，有新版本时在托盘提示，不会自动安装。"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="反馈与日志" Style="{StaticResource Heading}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                               Text="日志只记录程序做了什么（来源程序、剪贴板格式、出错原因），不记录复制的内容。遇到问题可以一键反馈，诊断文件会作为附件放进 GitHub 问题里。"/>
                    <WrapPanel>
                        <Button Style="{StaticResource Btn}" Content="一键反馈…" Click="Feedback_Click" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource Btn}" Content="查看日志" Click="OpenLog_Click" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource Btn}" Content="打开日志文件夹" Click="OpenLogFolder_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}" Margin="0">
                <StackPanel>
                    <TextBlock Text="数据" Style="{StaticResource Heading}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="DataPath" Style="{StaticResource Hint}"/>
                    <TextBlock x:Name="Stats" Style="{StaticResource Hint}" Margin="0,2,0,4"/>
                    <TextBlock x:Name="MoveStatus" Style="{StaticResource Hint}" Margin="0,2,0,4" Visibility="Collapsed"
                               Foreground="{DynamicResource Accent}"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource Btn}" Content="打开数据文件夹" Click="OpenFolder_Click" Margin="0,0,8,8"/>
                        <Button x:Name="MoveBtn" Style="{StaticResource Btn}" Content="更改位置…" Click="Move_Click" Margin="0,0,8,8"/>
                        <Button x:Name="ResetBtn" Style="{StaticResource Btn}" Content="恢复默认位置" Click="ResetLocation_Click" Margin="0,0,8,8"/>
                        <Button x:Name="ClearBtn" Style="{StaticResource Btn}" Content="清空历史…" Click="Clear_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                               Text="历史记录和图片会整体搬到新位置，确认复制完整后才删除原来的。设置和日志始终留在 %APPDATA%\AgosClip。"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="Version" Style="{StaticResource Hint}" Margin="2,10,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
</Window>
