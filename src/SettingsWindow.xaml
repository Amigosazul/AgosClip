<Window x:Class="AgosClip.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgosClip 设置" Width="700" Height="520" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/AgosClip.ico"
        Background="{DynamicResource PanelBg}" Foreground="{DynamicResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <!-- immersive title bar: no system caption; content (sidebar, glass) runs to the top edge.
         The top 40 px still drags the window; our own minimise/close buttons sit in it. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- caption buttons (Win11 metrics: 46×32; close turns red) -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Track}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#B22A1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubFg}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Toggle switch: label + hint on the left, switch on the right -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <ContentPresenter/>
                                <TextBlock Text="{TemplateBinding Tag}" Foreground="{DynamicResource SubFg}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,2,0,0" x:Name="hint"/>
                            </StackPanel>
                            <Border x:Name="track" Grid.Column="1" Width="40" Height="20" CornerRadius="10" VerticalAlignment="Center"
                                    Background="Transparent" BorderBrush="{DynamicResource SubFg}" BorderThickness="1">
                                <Ellipse x:Name="knob" Width="12" Height="12" Fill="{DynamicResource SubFg}"
                                         HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="hint" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="knob" Property="Fill" Value="{DynamicResource AccentFg}"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Retention chip -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="GroupName" Value="retention"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="14" Padding="12,4" BorderThickness="1"
                                BorderBrush="{DynamicResource CardBorder}" Background="{DynamicResource Track}">
                            <ContentPresenter x:Name="c" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Padding="14,6" BorderThickness="1"
                                BorderBrush="{DynamicResource CardBorder}" Background="{DynamicResource CardBg}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SelBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- left navigation -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" CornerRadius="7" Padding="10,7" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="i" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{StaticResource IconFont}" FontSize="14" Width="22" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubFg}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Track}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SelBg}"/>
                                <Setter TargetName="i" Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBorder}"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,14"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource PanelBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource Track}" Padding="10,12,10,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,14">
                    <Image Source="pack://application:,,,/Assets/AgosClip.ico" Width="20" Height="20" Margin="0,0,8,0"/>
                    <TextBlock Text="AgosClip" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="Version" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="8,0,0,0"/>
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="Nav_SelectionChanged" Foreground="{DynamicResource Fg}">
                    <ListBoxItem Tag="&#xE713;" Content="通用"/>
                    <ListBoxItem Tag="&#xE81C;" Content="记录"/>
                    <ListBoxItem Tag="&#xE8B7;" Content="存储与日志"/>
                    <ListBoxItem Tag="&#xE895;" Content="更新"/>
                    <ListBoxItem Tag="&#xE946;" Content="关于与反馈"/>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Pages -->
        <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="22,14,22,18">

                <!-- 通用 -->
                <StackPanel x:Name="PageGeneral">
                    <TextBlock Text="通用" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <CheckBox x:Name="TakeOverWinV" Style="{StaticResource Switch}" Click="Changed" Margin="0,2"
                                      Content="用 Win+V 打开" Tag="代替系统剪贴板；关闭或退出后恢复系统的 Win+V"/>
                            <Border Style="{StaticResource Sep}"/>
                            <CheckBox x:Name="PasteAfterSelect" Style="{StaticResource Switch}" Click="Changed" Margin="0,2"
                                      Content="选中后自动粘贴" Tag="关闭则只复制，自己按 Ctrl+V"/>
                            <Border Style="{StaticResource Sep}"/>
                            <CheckBox x:Name="StartWithWindows" Style="{StaticResource Switch}" Click="Changed" Margin="0,2" Content="开机自动启动"/>
                            <Border Style="{StaticResource Sep}"/>
                            <CheckBox x:Name="GlassBox" Style="{StaticResource Switch}" Click="Changed" Margin="0,2"
                                      Content="毛玻璃效果" Tag="需要 Windows 11 22H2+ 并打开系统“透明效果”"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 记录 -->
                <StackPanel x:Name="PageHistory" Visibility="Collapsed">
                    <TextBlock Text="记录" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="保留天数" Style="{StaticResource Label}"/>
                            <WrapPanel x:Name="Retention"/>
                            <TextBlock Style="{StaticResource Hint}" Text="过期自动删除，固定的条目除外"/>
                            <Border Style="{StaticResource Sep}" Margin="0,10,0,6"/>
                            <CheckBox x:Name="RecordImages" Style="{StaticResource Switch}" Click="Changed" Margin="0,2" Content="记录图片"/>
                            <Border Style="{StaticResource Sep}"/>
                            <CheckBox x:Name="ShowDateCards" Style="{StaticResource Switch}" Click="Changed" Margin="0,2"
                                      Content="显示日期卡片栏" Tag="关闭时面板更紧凑，用标题旁的 ‹ › 或日历切换日期"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Section}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="清空历史"/>
                                <TextBlock x:Name="Stats" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <Button x:Name="ClearBtn" Style="{StaticResource Btn}" Content="清空…" Click="Clear_Click"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 存储与日志 -->
                <StackPanel x:Name="PageStorage" Visibility="Collapsed">
                    <TextBlock Text="存储与日志" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="数据位置" Style="{StaticResource Label}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="DataPath" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            <TextBlock x:Name="StorageStats" Style="{StaticResource Hint}"/>
                            <TextBlock x:Name="MoveStatus" Style="{StaticResource Hint}" Visibility="Collapsed" Foreground="{DynamicResource Accent}"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="MoveBtn" Style="{StaticResource Btn}" Content="更改位置…" Click="Move_Click"/>
                                <Button x:Name="ResetBtn" Style="{StaticResource Btn}" Content="恢复默认" Click="ResetLocation_Click"/>
                                <Button Style="{StaticResource Btn}" Content="打开文件夹" Click="OpenFolder_Click"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="历史、图片和日志一起搬，复制完整后才删除原来的"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="日志大小上限" Style="{StaticResource Label}"/>
                            <WrapPanel x:Name="LogSize"/>
                            <TextBlock x:Name="LogStats" Style="{StaticResource Hint}"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource Btn}" Content="查看日志" Click="OpenLog_Click"/>
                                <Button Style="{StaticResource Btn}" Content="打开日志文件夹" Click="OpenLogFolder_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 更新 -->
                <StackPanel x:Name="PageUpdate" Visibility="Collapsed">
                    <TextBlock Text="更新" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock x:Name="UpdateStatus" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <TextBlock x:Name="UpdateNotes" Style="{StaticResource Hint}" Margin="0,0,0,10" Visibility="Collapsed"
                                       MaxHeight="110" TextTrimming="CharacterEllipsis"/>
                            <Border x:Name="ProgressTrack" Height="6" CornerRadius="3" Background="{DynamicResource Track}"
                                    Margin="0,0,0,10" Visibility="Collapsed">
                                <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="{DynamicResource Accent}"/>
                            </Border>
                            <WrapPanel>
                                <Button x:Name="CheckBtn" Style="{StaticResource Btn}" Content="检查更新" Click="Check_Click"/>
                                <Button x:Name="InstallBtn" Style="{StaticResource Btn}" Click="Install_Click" Visibility="Collapsed"/>
                                <Button x:Name="BrowserBtn" Style="{StaticResource Btn}" Content="用浏览器下载" Click="Browser_Click" Visibility="Collapsed"
                                        ToolTip="用浏览器从最快的线路下载安装包，下载后双击安装"/>
                                <Button x:Name="PageBtn" Style="{StaticResource Btn}" Content="发布页" Click="Page_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Section}">
                        <CheckBox x:Name="AutoUpdate" Style="{StaticResource Switch}" Click="Changed" Margin="0,2"
                                  Content="自动检查更新" Tag="每天一次，有新版本时托盘提示，不会自动安装"/>
                    </Border>
                </StackPanel>

                <!-- 关于与反馈 -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <TextBlock Text="关于与反馈" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock x:Name="AboutVersion" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Hint}" Text="剪贴板数据只保存在本机，只有检查更新时会联网。"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Section}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,110,0">
                                <TextBlock Text="一键反馈"/>
                                <TextBlock Style="{StaticResource Hint}" Text="生成诊断文件（不含复制的内容）并打开 GitHub 问题页"/>
                            </StackPanel>
                            <Button Style="{StaticResource Btn}" Content="反馈…" Click="Feedback_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Section}">
                        <Grid>
                            <TextBlock Text="源代码与发布" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource Btn}" Content="GitHub" Click="Page_Click" HorizontalAlignment="Right" Margin="0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <!-- caption buttons over the content column (immersive title bar) -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10">
            <Button Style="{StaticResource CaptionBtn}" Content="&#xE921;" ToolTip="最小化" Click="Minimize_Click"/>
            <Button Style="{StaticResource CloseBtn}" Content="&#xE8BB;" ToolTip="关闭" Click="CloseWindow_Click"/>
        </StackPanel>
    </Grid>
</Window>
