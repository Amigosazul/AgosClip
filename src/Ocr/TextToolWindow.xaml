<Window x:Class="AgosClip.TextToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="识别文字" Width="560" Height="560" MinWidth="380" MinHeight="320" ShowInTaskbar="True" Topmost="True"
        WindowStartupLocation="Manual" Icon="pack://application:,,,/Assets/AgosClip.ico"
        Background="{DynamicResource PanelBg}" Foreground="{DynamicResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <!-- immersive like the preview window: our header is the title bar, resizable from the edges -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Pane" TargetType="TextBox">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource PanelBg}" Padding="12,8,12,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="ResultRow" Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Margin="2,0,-2,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="Heading" Text="识别文字" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock x:Name="Info" FontSize="11" Foreground="{DynamicResource SubFg}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                </StackPanel>
                <Button x:Name="TopBtn" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE718;" FontSize="12"
                        ToolTip="置顶 / 取消置顶" Click="Top_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12"
                        ToolTip="关闭 (Esc)" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <!-- source text (editable: fix a misread character before copying or translating) -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Grid>
                    <TextBox x:Name="Source" Style="{StaticResource Pane}" TextChanged="Source_TextChanged"/>
                    <TextBlock x:Name="SourceMessage" Margin="20" TextAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SubFg}" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- actions between the two panes -->
            <DockPanel Grid.Row="2" Margin="0,8" LastChildFill="False">
                <Button x:Name="CopySourceBtn" Style="{StaticResource PillButton}" Content="复制原文" Click="CopySource_Click" Margin="0,0,8,0"/>
                <Button x:Name="TranslateBtn" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="翻译" Click="Translate_Click"/>
                <Button x:Name="TargetBtn" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Click="Target_Click" Margin="0,0,8,0"
                        ToolTip="翻译成哪种语言"/>
            </DockPanel>

            <!-- translation -->
            <Border x:Name="ResultCard" Grid.Row="3" Style="{StaticResource Card}">
                <Grid>
                    <TextBox x:Name="Result" Style="{StaticResource Pane}" IsReadOnly="True"/>
                    <TextBlock x:Name="ResultMessage" Margin="20" TextAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SubFg}"
                               Text="点「翻译」在这里显示译文"/>
                </Grid>
            </Border>

            <DockPanel Grid.Row="4" Margin="0,8,0,0" LastChildFill="False">
                <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource SubFg}" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="CopyResultBtn" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="复制译文" Click="CopyResult_Click" IsEnabled="False"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
